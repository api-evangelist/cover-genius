    "_postman_id": "041df03b-7ba8-4687-af49-702b22a01c05",
    "name": "Cover Genius XCover Bookings API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The XCover distribution API from Cover Genius lets partners create embedded insurance offers (quotes) at the point of sale, confirm them into bound policies (bookings), retrieve and modify bookings, and cancel them. Requests are authenticated with an HTTP Signature (HMAC) scheme using an X-Api-Key header, a Date header, and an Authorization signature header. This document models the documented XCover Offers and Bookings surface served from https://api.xcover.com/x.\n\nContact Support:\n Name: Cover Genius Partner Support",
      "type": "text/plain"
    }
  }
